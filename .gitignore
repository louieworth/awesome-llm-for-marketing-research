# Keep the collection, contribution guide, and original theme artwork.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/SURVEY.md
!/assets/
/assets/*
!/assets/research-landscape.svg
!/assets/banner.png

# Strict method review and supporting papers.
!/docs/
/docs/*
!/docs/consumer-simulation-review.md
!/docs/consumer-simulation-method-supplement.md

# Paper-scan pipeline: agents, skills, scripts, and review records.
!/.claude/
/.claude/*
!/.claude/agents/
!/.claude/skills/
!/.claude/settings.json
!/scripts/
!/scan/
/scan/*
!/scan/proposals/
!/scan/README.md
__pycache__/
